  "_meta": {
    "descrizione": "Conversione dei click del setup di ACC nel valore che il gioco mostra, vettura per vettura (chiave = carName del file di ACC). Una vettura assente resta in click: niente valori generici. Si legge in app/core/setup_params.py (click_in_reale).",
    "tipi": {
      "lineare": "reale = base + passo × click",
      "elenco": "reale = valori[click]; il click più alto è l'ultimo dell'elenco"
    },
    "click_max": "click più alto possibile; null = non lo sappiamo (nessuna fonte lo dà): si converte lo stesso, ma senza un limite in alto",
    "stati": {
      "gioco": "letta a schermo in ACC",
      "fonti": "almeno due fonti indipendenti concordi, non ancora vista a schermo in ACC",
      "DA_VERIFICARE": "non si usa: il parametro (o la vettura intera) resta in click"
    },
    "fonti": {
      "RE": "Race Element · github.com/RiddleTime/Race-Element · commit 55121bb (20/09/2026) · Race_Element.Data.ACC/SetupParser/Cars/GT3/*.cs e SetupConverter.cs · GPL-3.0 (ripresi i numeri, non il codice)",
