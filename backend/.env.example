# ── API Anthropic (SOLO lato server, mai nel frontend) ──
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_MODEL=claude-haiku-4-5

# ── Live-mode (protezione API key) ──
# 0 (default) = demo-mode forzata (cache offline): la demo non consuma la chiave.
# 1 = abilita la LLM reale (richiede la chiave nei secret del server).
PITWALL_ALLOW_LIVE=0
PITWALL_DEMO_MODE=1

# ── Limiti token ──
PITWALL_MAX_OUTPUT_TOKENS=2500
PITWALL_MAX_INPUT_TOKENS=8000

# ── CORS: origine/i del frontend Next.js (virgola-separate) ──
PITWALL_CORS_ORIGINS=http://localhost:3000
