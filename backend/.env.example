# ── API Anthropic (SOLO lato server, mai nel frontend) ──
ANTHROPIC_API_KEY=your_anthropic_key_here
LLM_MODEL=claude-haiku-4-5

# ── Live-mode (protezione API key) ──
# 0 (default) = demo-mode forzata (cache offline): la demo non consuma la chiave,
#   e la lettura setup da screenshot risponde 503 senza chiamare il modello.
# 1 = consente la LLM reale (richiede la chiave nei secret del server).
PITWALL_ALLOW_LIVE=0
# Conta solo con PITWALL_ALLOW_LIVE=1: per usare davvero la LLM reale va messo a 0.
PITWALL_DEMO_MODE=1

# ── Limiti token ──
PITWALL_MAX_OUTPUT_TOKENS=2500
PITWALL_MAX_INPUT_TOKENS=8000
# Tetto di output di ogni risposta della chat di Gigi.
PITWALL_CHAT_MAX_TOKENS=800

# ── Registri scritti dal client LLM (solo con la LLM reale accesa) ──
# Token stimati per chiamata e guasti delle chiamate ad Anthropic, in markdown.
# Default: backend/logs/llm_token_log.md e backend/logs/llm_incidents.md, percorsi
# assoluti fissati in app/config.py (backend/logs/ e' gitignorata; li' c'e' anche
# pitwall.log, il log dell'app con un request-id per richiesta).
# Se li cambi qui: un percorso relativo parte dalla cartella di avvio del backend,
# e la cartella deve gia' esistere (il file viene creato, la cartella no).
# PITWALL_PROMPT_LOG_PATH=logs/llm_token_log.md
# PITWALL_INCIDENTS_PATH=logs/llm_incidents.md

# ── CORS: origine/i del frontend Next.js (virgola-separate) ──
PITWALL_CORS_ORIGINS=http://localhost:3000
