# URL del backend FastAPI (dev). In produzione: l'URL pubblico del backend (piattaforma da decidere).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Client ID OAuth di Google per l'accesso con Google in /login. E' un identificatore
# PUBBLICO, non un segreto. Se resta vuoto l'accesso con Google non e' disponibile:
# si entra comunque con «Entra in modalita' demo».
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
